<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>مركز الشفلح التعليمي</title>

<link rel="icon" type="image/png" href="data:image/webp;base64,">
<meta property="og:title" content="مركز الشفلح التعليمي">
<meta property="og:description" content="تطبيق تعليمي تفاعلي — تعلم المهن ورتّب الأعداد">
<meta property="og:image" content="data:image/webp;base64,">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="مركز الشفلح التعليمي">
<meta name="twitter:image" content="data:image/webp;base64,">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&family=Baloo+2:wght@700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#07090f;--card:#111827;--card2:#1a2338;
  --gold:#f5c842;--mint:#3de8b0;--rose:#ff6b8a;
  --sky:#5bc8ff;--purple:#c084fc;--orange:#ff9f4a;
  --text:#f0f4ff;--muted:#6b7fa3;--green:#4ade80;--red:#f87171;
  --border:rgba(255,255,255,.08);
}
body{font-family:"Tajawal",sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}

/* ── Stars bg ── */
#stars{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.star{position:absolute;border-radius:50%;animation:twinkle linear infinite}
@keyframes twinkle{0%,100%{opacity:.08;transform:scale(1)}50%{opacity:.8;transform:scale(1.5)}}
#floaters{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.floater{position:absolute;font-family:"Baloo 2",cursive;font-weight:800;animation:floatUp linear infinite;opacity:.03;color:#fff}
@keyframes floatUp{0%{transform:translateY(110vh) rotate(0)}100%{transform:translateY(-20vh) rotate(360deg)}}
.z1{position:relative;z-index:1}


/* ── Shafallah Logo ── */
.shafallah-logo{display:block;width:130px;margin:0 auto 16px;filter:drop-shadow(0 4px 12px rgba(110,30,130,.25))}
.login-logo-wrap{text-align:center;margin-bottom:0}

/* ── Sound btn ── */
.snd-btn{position:fixed;top:16px;left:16px;z-index:300;background:var(--card);border:1px solid var(--border);border-radius:50%;width:46px;height:46px;font-size:1.4rem;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#fff;transition:all .2s}
.snd-btn:hover{transform:scale(1.1);background:rgba(255,255,255,.1)}

/* Flash */
.flash{position:fixed;inset:0;pointer-events:none;z-index:500;opacity:0;transition:opacity .12s}
.flash.g{background:rgba(74,222,128,.22)}.flash.r{background:rgba(248,113,113,.22)}

/* ══════════════════════════════
   SHARED LOGIN
══════════════════════════════ */
#login-screen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.lbox{
  background:linear-gradient(145deg,#111827,#1a2338);
  border:2px solid var(--border);border-radius:32px;
  padding:44px 36px;max-width:450px;width:100%;
  box-shadow:0 30px 80px rgba(0,0,0,.7);position:relative;overflow:hidden;
}
.lbox::before{content:"";position:absolute;top:-50px;left:-50px;width:200px;height:200px;background:radial-gradient(circle,rgba(91,200,255,.15),transparent 70%);pointer-events:none}
.lbox::after{content:"";position:absolute;bottom:-50px;right:-50px;width:200px;height:200px;background:radial-gradient(circle,rgba(192,132,252,.12),transparent 70%);pointer-events:none}
.l-icon{font-size:4rem;text-align:center;display:block;margin-bottom:10px;animation:iconBounce 2s ease-in-out infinite}
@keyframes iconBounce{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-10px) rotate(5deg)}}
.l-title{text-align:center;font-size:2rem;font-weight:900;background:linear-gradient(90deg,var(--gold),var(--mint));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:4px}
.l-sub{text-align:center;color:var(--muted);font-size:.92rem;margin-bottom:28px}
.fl{margin-bottom:18px}
.fl label{font-size:.88rem;font-weight:700;color:var(--muted);display:block;margin-bottom:7px}
.fi{width:100%;padding:14px 18px;background:rgba(255,255,255,.05);border:2px solid var(--border);border-radius:14px;color:var(--text);font-family:"Tajawal",sans-serif;font-size:1.1rem;font-weight:700;text-align:center;outline:none;transition:all .3s}
.fi:focus{border-color:var(--mint);background:rgba(61,232,176,.07);box-shadow:0 0 0 4px rgba(61,232,176,.1)}
.fi::placeholder{color:var(--muted);font-weight:400}
.fi.err{border-color:var(--rose);animation:lshake .4s ease}
.fi.ok{border-color:var(--green)}
.fhint{font-size:.8rem;text-align:center;margin-top:5px;min-height:18px}
.fhint.e{color:var(--rose)}.fhint.s{color:var(--green)}
@keyframes lshake{0%,100%{transform:translateX(0)}25%{transform:translateX(-10px)}75%{transform:translateX(10px)}}
.lbtn{width:100%;padding:17px;margin-top:10px;background:linear-gradient(135deg,var(--gold),var(--orange));color:#07090f;border:none;border-radius:16px;font-family:"Tajawal",sans-serif;font-size:1.3rem;font-weight:900;cursor:pointer;transition:all .3s;box-shadow:0 8px 28px rgba(245,200,66,.35)}
.lbtn:hover{transform:translateY(-3px) scale(1.02);box-shadow:0 16px 40px rgba(245,200,66,.5)}

/* ══════════════════════════════
   HOME SCREEN (choose activity)
══════════════════════════════ */
#home-screen{display:none}
.home-wrap{max-width:820px;margin:0 auto;padding:30px 20px;text-align:center}
.home-top{margin-bottom:10px}
.welcome-txt{font-size:1.6rem;font-weight:900;background:linear-gradient(90deg,var(--gold),var(--mint));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:4px}
.home-sub{color:var(--muted);font-size:1rem;margin-bottom:30px}
.home-badge{display:inline-flex;gap:10px;background:var(--card);border:1px solid var(--border);border-radius:14px;padding:8px 20px;font-size:.9rem;margin-bottom:36px;flex-wrap:wrap;justify-content:center}
.hb-item{font-weight:700}.hb-item span{color:var(--mint)}

.activities-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;max-width:680px;margin:0 auto 30px}
.act-card{
  background:var(--card);border:2px solid var(--border);border-radius:28px;
  padding:32px 20px;cursor:pointer;transition:all .3s;
  position:relative;overflow:hidden;text-align:center;
}
.act-card::before{content:"";position:absolute;inset:0;opacity:0;transition:opacity .3s}
.act-card:nth-child(1)::before{background:radial-gradient(ellipse at 50% 0%,rgba(245,200,66,.12),transparent 65%)}
.act-card:nth-child(2)::before{background:radial-gradient(ellipse at 50% 0%,rgba(61,232,176,.12),transparent 65%)}
.act-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.2)}
.act-card:hover::before{opacity:1}
.act-card:hover .act-icon{transform:scale(1.15) rotate(5deg)}
.act-icon{font-size:4rem;display:block;margin-bottom:14px;transition:transform .3s;filter:drop-shadow(0 4px 12px rgba(0,0,0,.4))}
.act-title{font-size:1.35rem;font-weight:900;margin-bottom:6px}
.act-card:nth-child(1) .act-title{color:var(--gold)}
.act-card:nth-child(2) .act-title{color:var(--mint)}
.act-desc{font-size:.88rem;color:var(--muted);line-height:1.6}
.act-badge{
  display:inline-block;margin-top:14px;
  border-radius:20px;padding:5px 14px;font-size:.78rem;font-weight:700;
}
.act-card:nth-child(1) .act-badge{background:rgba(245,200,66,.15);color:var(--gold);border:1px solid rgba(245,200,66,.25)}
.act-card:nth-child(2) .act-badge{background:rgba(61,232,176,.15);color:var(--mint);border:1px solid rgba(61,232,176,.25)}

/* ══════════════════════════════
   TOP BAR (shared between both activities)
══════════════════════════════ */
.topbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;background:var(--card);border-radius:18px;padding:12px 18px;margin-bottom:18px;border:1px solid var(--border)}
.tb-name{font-size:.9rem;font-weight:700;color:var(--mint)}
.tb-cls{background:rgba(245,200,66,.13);border:1px solid rgba(245,200,66,.28);border-radius:10px;padding:4px 13px;font-size:.8rem;font-weight:700;color:var(--gold)}
.tb-score{display:flex;align-items:center;gap:5px;background:rgba(192,132,252,.1);border:1px solid rgba(192,132,252,.22);border-radius:10px;padding:5px 13px;font-size:.9rem;font-weight:900;color:var(--purple)}
.tb-home{background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:10px;padding:5px 13px;font-size:.85rem;cursor:pointer;color:var(--text);transition:all .2s;font-family:"Tajawal",sans-serif;font-weight:700}
.tb-home:hover{background:rgba(255,255,255,.12)}

/* ══════════════════════════════
   JOBS APP
══════════════════════════════ */
#jobs-app{display:none}
.jwrap{max-width:860px;margin:0 auto;padding:16px}

/* score bar */
.jobs-score-bar{display:flex;justify-content:center;align-items:center;gap:22px;background:var(--card);border-radius:18px;padding:11px 22px;margin:0 auto 14px;max-width:440px;border:1px solid var(--border)}
.jsi{text-align:center}.jsn{font-size:1.7rem;font-weight:900;color:var(--gold)}.jsl{font-size:.78rem;color:var(--muted)}
.jsdiv{width:1px;height:32px;background:var(--border)}

/* progress */
.jprog-c{max-width:440px;margin:0 auto 18px}
.jprog-lbl{display:flex;justify-content:space-between;font-size:.8rem;color:var(--muted);margin-bottom:5px}
.jprog-bar{height:9px;background:rgba(255,255,255,.08);border-radius:20px;overflow:hidden}
.jprog-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--orange));border-radius:20px;transition:width .6s ease}

/* job card */
.job-display{text-align:center;margin-bottom:22px}
.job-card{display:inline-block;background:var(--card);border-radius:26px;padding:14px;border:3px solid var(--border);box-shadow:0 20px 60px rgba(0,0,0,.5);position:relative;overflow:hidden;max-width:300px;width:100%}
.job-card::before{content:"";position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,var(--gold),var(--orange),var(--rose))}
.img-wrap{width:100%;aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#fff;display:flex;align-items:center;justify-content:center}
.img-wrap img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .4s}
.job-card:hover .img-wrap img{transform:scale(1.05)}
.qtext{font-size:1.05rem;color:var(--muted);font-weight:700;margin-top:10px}

/* options */
.jopts-title{text-align:center;font-size:1.2rem;font-weight:700;color:var(--gold);margin-bottom:14px}
.jopts-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px;max-width:540px;margin:0 auto}
.jopt{background:var(--card);border:2.5px solid var(--border);border-radius:18px;padding:22px 12px;cursor:pointer;transition:all .22s;text-align:center;position:relative;overflow:hidden}
.jopt:hover{border-color:var(--sky);transform:translateY(-4px);box-shadow:0 12px 32px rgba(91,200,255,.22)}
.jopt-text{font-size:1.65rem;font-weight:900;color:var(--text);letter-spacing:3px}
.jopt.correct{border-color:var(--green);background:rgba(74,222,128,.16);animation:pgreen .5s ease}
.jopt.wrong{border-color:var(--red);background:rgba(248,113,113,.16);animation:jshake .5s ease}
@keyframes pgreen{0%{transform:scale(1)}50%{transform:scale(1.06)}100%{transform:scale(1)}}
@keyframes jshake{0%,100%{transform:translateX(0)}25%{transform:translateX(-9px)}75%{transform:translateX(9px)}}

.jfeedback{text-align:center;font-size:1.4rem;font-weight:900;min-height:52px;display:flex;align-items:center;justify-content:center;margin:16px 0;border-radius:16px;transition:all .3s}
.jfeedback.ok{color:var(--green);background:rgba(74,222,128,.1);padding:12px;animation:fbIn .4s ease}
.jfeedback.no{color:var(--rose);background:rgba(255,107,138,.1);padding:12px;animation:fbIn .4s ease}
@keyframes fbIn{0%{transform:scale(.8);opacity:0}60%{transform:scale(1.06)}100%{transform:scale(1);opacity:1}}

.jnext{display:block;margin:14px auto 26px;background:linear-gradient(135deg,var(--gold),var(--orange));color:#07090f;border:none;border-radius:18px;padding:15px 46px;font-size:1.15rem;font-weight:900;font-family:"Tajawal",sans-serif;cursor:pointer;transition:all .3s;opacity:0;pointer-events:none;box-shadow:0 8px 24px rgba(245,200,66,.35)}
.jnext.show{opacity:1;pointer-events:all;animation:sUp .4s ease forwards}

/* ripple */
.ripple{position:absolute;border-radius:50%;width:80px;height:80px;background:rgba(255,255,255,.2);transform:scale(0);animation:rAnim .5s ease-out forwards;pointer-events:none}
@keyframes rAnim{to{transform:scale(4);opacity:0}}

/* ══════════════════════════════
   NUMBERS APP
══════════════════════════════ */
#nums-app{display:none}
.nwrap{max-width:920px;margin:0 auto;padding:16px}

.round-info{text-align:center;margin-bottom:16px}
.round-lbl{font-size:.95rem;color:var(--muted);margin-bottom:7px}
.round-dots{display:flex;justify-content:center;gap:7px;flex-wrap:wrap}
.rdot{width:16px;height:16px;border-radius:50%;background:rgba(255,255,255,.1);border:2px solid rgba(255,255,255,.15);transition:all .4s}
.rdot.done{background:var(--green);border-color:var(--green);box-shadow:0 0 8px rgba(74,222,128,.5)}
.rdot.curr{background:var(--gold);border-color:var(--gold);animation:pulseDot 1s ease-in-out infinite;box-shadow:0 0 10px rgba(245,200,66,.6)}
@keyframes pulseDot{0%,100%{transform:scale(1)}50%{transform:scale(1.3)}}

.ninstr{background:linear-gradient(135deg,rgba(61,232,176,.1),rgba(91,200,255,.1));border:1px solid rgba(61,232,176,.2);border-radius:14px;padding:12px 18px;text-align:center;margin-bottom:16px;font-size:.95rem;font-weight:700;color:var(--mint)}
.sel-hint{text-align:center;font-size:.82rem;color:var(--gold);margin-bottom:8px;min-height:18px;font-weight:700}

.pool-lbl,.slots-lbl{font-size:.85rem;font-weight:700;color:var(--muted);margin-bottom:9px;text-align:center}
.pool{display:flex;flex-wrap:wrap;justify-content:center;gap:9px;background:var(--card);border-radius:18px;padding:16px;border:2px dashed rgba(255,255,255,.1);min-height:76px;transition:border-color .3s}
.pool.drag-over{border-color:var(--sky);background:rgba(91,200,255,.05)}
.slots{display:flex;flex-wrap:wrap;justify-content:center;gap:7px;background:var(--card);border-radius:18px;padding:16px;border:2px solid var(--border);min-height:76px}
.slot{width:52px;height:52px;border-radius:13px;border:2px dashed rgba(255,255,255,.2);background:rgba(255,255,255,.03);display:flex;align-items:center;justify-content:center;position:relative;transition:all .3s;flex-direction:column}
.slot.filled{border-style:solid;border-color:var(--sky);background:rgba(91,200,255,.08)}
.slot.correct-slot{border-color:var(--green);background:rgba(74,222,128,.12);animation:slotPop .4s ease}
.slot.wrong-slot{border-color:var(--red);background:rgba(248,113,113,.12);animation:lshake .4s ease}
@keyframes slotPop{0%{transform:scale(.8)}60%{transform:scale(1.1)}100%{transform:scale(1)}}
.slot.drag-over-slot{border-color:var(--gold);background:rgba(245,200,66,.1);transform:scale(1.08)}
.slot-num{font-size:.55rem;color:rgba(255,255,255,.2);position:absolute;bottom:2px;right:4px;font-weight:700}

.tile{width:52px;height:52px;border-radius:13px;background:linear-gradient(135deg,var(--card2),#222d45);border:2px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;font-family:"Baloo 2",cursive;font-weight:800;font-size:1.45rem;color:var(--text);cursor:grab;transition:all .2s;user-select:none;box-shadow:0 4px 12px rgba(0,0,0,.3);position:relative}
.tile:hover{transform:translateY(-4px) scale(1.08);border-color:var(--sky);box-shadow:0 10px 26px rgba(91,200,255,.25);color:var(--sky)}
.tile:active{cursor:grabbing;transform:scale(.95)}
.tile.dragging{opacity:.3;transform:scale(.9)}
.tile.correct-tile{background:linear-gradient(135deg,rgba(74,222,128,.25),rgba(61,232,176,.2));border-color:var(--green);color:var(--green);animation:tilePop .5s ease}
.tile.wrong-tile{background:linear-gradient(135deg,rgba(248,113,113,.25),rgba(255,107,138,.2));border-color:var(--red);color:var(--red)}
@keyframes tilePop{0%{transform:scale(.7) rotate(-10deg)}60%{transform:scale(1.15) rotate(5deg)}100%{transform:scale(1) rotate(0)}}
.tile.selected{border-color:var(--gold);background:linear-gradient(135deg,rgba(245,200,66,.25),rgba(255,159,74,.2));color:var(--gold);transform:scale(1.12);box-shadow:0 0 0 3px rgba(245,200,66,.4),0 10px 26px rgba(245,200,66,.3);animation:selectedPulse 1s ease-in-out infinite}
@keyframes selectedPulse{0%,100%{box-shadow:0 0 0 3px rgba(245,200,66,.4)}50%{box-shadow:0 0 0 6px rgba(245,200,66,.2)}}

.check-btn{display:block;margin:14px auto 8px;width:100%;max-width:380px;background:linear-gradient(135deg,var(--purple),var(--rose));color:#fff;border:none;border-radius:18px;padding:15px 40px;font-size:1.15rem;font-weight:900;font-family:"Tajawal",sans-serif;cursor:pointer;transition:all .3s;box-shadow:0 8px 24px rgba(192,132,252,.35);opacity:.35;pointer-events:none}
.check-btn.ready{opacity:1;pointer-events:all;animation:btnReady .5s ease}
@keyframes btnReady{0%{transform:scale(.95)}60%{transform:scale(1.04)}100%{transform:scale(1)}}
.check-btn:hover{transform:translateY(-3px);box-shadow:0 16px 36px rgba(192,132,252,.5)}

.nresult{text-align:center;font-size:1.3rem;font-weight:900;min-height:54px;display:flex;align-items:center;justify-content:center;margin:12px 0;border-radius:16px;transition:all .3s}
.nresult.ok{color:var(--green);background:rgba(74,222,128,.1);padding:12px;animation:fbIn .4s ease}
.nresult.no{color:var(--rose);background:rgba(255,107,138,.1);padding:12px;animation:fbIn .4s ease}

.nnext{display:block;margin:0 auto 24px;background:linear-gradient(135deg,var(--mint),var(--sky));color:#07090f;border:none;border-radius:18px;padding:15px 46px;font-size:1.15rem;font-weight:900;font-family:"Tajawal",sans-serif;cursor:pointer;transition:all .3s;opacity:0;pointer-events:none;box-shadow:0 8px 24px rgba(61,232,176,.35)}
.nnext.show{opacity:1;pointer-events:all;animation:sUp .4s ease forwards}
@keyframes sUp{from{transform:translateY(16px);opacity:0}to{transform:translateY(0);opacity:1}}

/* ══════════════════════════════
   SHARED END SCREEN
══════════════════════════════ */
#end-screen{display:none;text-align:center;padding:36px 20px}
.end-wrap{max-width:600px;margin:0 auto}
.end-trophy{font-size:5rem;display:block;animation:eTrophy 1s infinite}
@keyframes eTrophy{0%,100%{transform:translateY(0) rotate(-8deg)}50%{transform:translateY(-20px) rotate(8deg)}}
.end-title{font-size:clamp(1.8rem,6vw,2.8rem);font-weight:900;background:linear-gradient(90deg,var(--gold),var(--rose));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:16px 0 8px}
.end-activity{font-size:.9rem;color:var(--muted);margin-bottom:4px}
.end-player{font-size:1.2rem;color:var(--mint);font-weight:700;margin-bottom:4px}
.end-sc{font-size:1rem;color:var(--muted);margin-bottom:18px}
.end-stars{font-size:3rem;letter-spacing:12px;margin-bottom:24px}
.end-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.replay-btn{background:linear-gradient(135deg,var(--purple),var(--rose));color:#fff;border:none;border-radius:18px;padding:16px 40px;font-size:1.15rem;font-weight:700;font-family:"Tajawal",sans-serif;cursor:pointer;transition:all .3s;box-shadow:0 10px 28px rgba(192,132,252,.4)}
.replay-btn:hover{transform:translateY(-4px);box-shadow:0 20px 48px rgba(192,132,252,.5)}
.home-btn2{background:linear-gradient(135deg,var(--card2),#2a3550);color:var(--text);border:1px solid var(--border);border-radius:18px;padding:16px 40px;font-size:1.15rem;font-weight:700;font-family:"Tajawal",sans-serif;cursor:pointer;transition:all .3s}
.home-btn2:hover{transform:translateY(-4px);border-color:var(--mint)}

/* Confetti */
.cp{position:fixed;border-radius:2px;animation:cfall linear forwards;z-index:999;pointer-events:none}
@keyframes cfall{0%{transform:translateY(-40px) rotate(0);opacity:1}100%{transform:translateY(100vh) rotate(720deg);opacity:0}}

@media(max-width:540px){
  .lbox{padding:28px 16px}
  .activities-grid{grid-template-columns:1fr;gap:14px}
  .tile{width:44px;height:44px;font-size:1.2rem;border-radius:11px}
  .slot{width:44px;height:44px;border-radius:11px}
  .jopt-text{font-size:1.4rem}
}
</style>
</head>
<body>

<div id="flash" class="flash"></div>
<button class="snd-btn" id="snd-btn" onclick="toggleSound()">🔊</button>
<div id="stars"></div>
<div id="floaters"></div>

<!-- ══ SHARED LOGIN ══ -->
