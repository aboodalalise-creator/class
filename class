<script>
/* ══ BG ══ */
(function(){
  const s=document.getElementById("stars");
  for(let i=0;i<70;i++){const d=document.createElement("div");d.className="star";const sz=1+Math.random()*2.5;d.style.cssText=`width:${sz}px;height:${sz}px;top:${Math.random()*100}%;left:${Math.random()*100}%;background:${["#fff","#5bc8ff","#c084fc","#f5c842"][i%4]};animation-duration:${2+Math.random()*4}s;animation-delay:${Math.random()*4}s`;s.appendChild(d);}
  const f=document.getElementById("floaters");
  for(let i=0;i<16;i++){const d=document.createElement("div");d.className="floater";d.textContent=1+Math.floor(Math.random()*20);const sz=40+Math.random()*90;d.style.cssText=`font-size:${sz}px;left:${Math.random()*100}%;animation-duration:${14+Math.random()*18}s;animation-delay:${Math.random()*14}s`;f.appendChild(d);}
})();

/* ══ AUDIO ══ */
let actx=null,soundOn=true;
function gCtx(){if(!actx)actx=new(window.AudioContext||window.webkitAudioContext)();return actx}
function tone(f,d,t,v,delay){if(!soundOn)return;t=t||"sine";v=v||.28;delay=delay||0;try{const c=gCtx(),o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.type=t;o.frequency.setValueAtTime(f,c.currentTime+delay);g.gain.setValueAtTime(v,c.currentTime+delay);g.gain.exponentialRampToValueAtTime(.001,c.currentTime+delay+d);o.start(c.currentTime+delay);o.stop(c.currentTime+delay+d+.01);}catch(e){}}
function playCorrect(){[523,659,784,1047].forEach((f,i)=>tone(f,.2,"sine",.3,i*.1))}
function playWrong(){[300,240,180].forEach((f,i)=>tone(f,.17,"sawtooth",.22,i*.12))}
function playClick(){tone(800,.07,"sine",.2)}
function playLogin(){[392,494,587,784].forEach((f,i)=>tone(f,.2,"sine",.28,i*.11))}
function playCelebration(){[523,659,784,1047,1319,1568].forEach((f,i)=>tone(f,.18,"sine",.3,i*.11))}
function playError(){tone(180,.3,"sawtooth",.22)}
function playPlace(){tone(660,.1,"sine",.25)}
function toggleSound(){soundOn=!soundOn;document.getElementById("snd-btn").textContent=soundOn?"🔊":"🔇";if(soundOn)playClick()}
function flashEl(type){const el=document.getElementById("flash");el.className="flash "+type;el.style.opacity="1";setTimeout(()=>el.style.opacity="0",180)}

/* ══ GLOBAL STATE ══ */
const CORRECT_CLASS="12";
let playerName="",playerClass="",currentActivity="";

/* ══ LOGIN ══ */
function clrE(f){document.getElementById("h-"+f).textContent="";document.getElementById("h-"+f).className="fhint";document.getElementById("in-"+f).classList.remove("err")}
function setErr(f,msg){document.getElementById("h-"+f).textContent=msg;document.getElementById("h-"+f).className="fhint e";document.getElementById("in-"+f).classList.add("err")}

function doLogin(){
  playClick();
  const name=document.getElementById("in-name").value.trim();
  const cls=document.getElementById("in-cls").value.trim();
  let ok=true;
  if(!name){setErr("name","⚠️ من فضلك أدخل اسمك!");playError();ok=false}
  if(!cls){setErr("cls","⚠️ أدخل رقم الفصل!");if(ok)playError();ok=false}
  else if(cls!==CORRECT_CLASS){
    setErr("cls","❌ رقم الفصل غير صحيح! الفصل الصحيح هو 12");
    document.getElementById("in-cls").value="";
    const b=document.querySelector(".lbox");b.style.animation="none";b.offsetHeight;b.style.animation="lshake .5s ease";
    playWrong();ok=false;
  }
  if(!ok)return;
  document.getElementById("in-cls").classList.add("ok");
  document.getElementById("h-cls").textContent="✅ رقم الفصل صحيح!";
  document.getElementById("h-cls").className="fhint s";
  playerName=name;playerClass=cls;
  playLogin();
  setTimeout(()=>{
    const l=document.getElementById("login-screen");l.style.transition="all .5s";l.style.opacity="0";l.style.transform="scale(.95)";
    setTimeout(()=>{l.style.display="none";showHome()},500);
  },700);
}

/* ══ HOME ══ */
function showHome(){
  hideAll();
  document.getElementById("home-screen").style.display="block";
  document.getElementById("hw-txt").textContent="أهلاً "+playerName+" 👋";
  document.getElementById("hb-name").textContent=playerName;
  document.getElementById("hb-cls").textContent=playerClass;
  playClick();
}

function goHome(){
  playClick();
  hideAll();
  showHome();
}

function hideAll(){
  ["login-screen","home-screen","jobs-app","nums-app","end-screen"].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.style.display="none";
  });
}

/* ══════════════════════════════
   JOBS ACTIVITY
══════════════════════════════ */
const jobImages = {
  "مصور": "data:image/webp;base64,",
  "معلم": "data:image/webp;base64,",
  "طيار": "data:image/webp;base64,",
  "سائق": "data:image/webp;base64,",
  "شرطي": "data:image/webp;base64,",
  "خباز": "data:image/webp;base64,",
  "حلاق": "data:image/webp;base64,",
  "طبيب": "data:image/webp;base64,",
};

const jobsList=[
  {name:"معلم"},{name:"مصور"},{name:"شرطي"},{name:"طبيب"},
  {name:"سائق"},{name:"خباز"},{name:"طيار"},{name:"حلاق"}
];

let jQuestions=[],jCurrent=0,jScore=0,jAnswered=false;

function startJobs(){
  playClick();currentActivity="jobs";
  jQuestions=shuffle([...jobsList]).map(job=>{
    const wrong=shuffle(jobsList.filter(j=>j.name!==job.name)).slice(0,3);
    return{correct:job,options:shuffle([job,...wrong])};
  });
  jCurrent=0;jScore=0;jAnswered=false;
  const n="👤 "+playerName,c="🏫 فصل "+playerClass;
  document.getElementById("jtb-name").textContent=n;
  document.getElementById("jtb-cls").textContent=c;
  document.getElementById("jtb-sc").textContent="0";
  hideAll();
  document.getElementById("jobs-app").style.display="block";
  jRender();
}

function jRender(){
  jAnswered=false;
  const q=jQuestions[jCurrent];
  document.getElementById("jimg").src=jobImages[q.correct.name];
  document.getElementById("jqnum").textContent=jCurrent+1;
  document.getElementById("jscore").textContent=jScore;
  document.getElementById("jprog-fill").style.width=(jCurrent/8*100)+"%";
  document.getElementById("jprog-txt").textContent=jCurrent+"/8";
  document.getElementById("jfb").textContent="";document.getElementById("jfb").className="jfeedback";
  document.getElementById("jnext").className="jnext";
  const grid=document.getElementById("jopts");grid.innerHTML="";
  q.options.forEach(opt=>{
    const btn=document.createElement("button");btn.className="jopt";
    btn.innerHTML=`<span class="jopt-text">${opt.name}</span>`;
    btn.onclick=e=>{jAddRipple(btn,e);jCheck(opt.name,q.correct.name,btn)};
    grid.appendChild(btn);
  });
}

function jAddRipple(btn,e){const r=document.createElement("span");r.className="ripple";const rect=btn.getBoundingClientRect();r.style.left=(e.clientX-rect.left-40)+"px";r.style.top=(e.clientY-rect.top-40)+"px";btn.appendChild(r);setTimeout(()=>r.remove(),600)}

function jCheck(chosen,correct,btn){
  if(jAnswered)return;jAnswered=true;
  document.querySelectorAll(".jopt").forEach(b=>b.style.pointerEvents="none");
  const fb=document.getElementById("jfb");
  if(chosen===correct){
    jScore++;btn.classList.add("correct");
    fb.textContent="🌟 ممتاز! إجابة صحيحة!";fb.className="jfeedback ok";
    playCorrect();flashEl("g");document.getElementById("jscore").textContent=jScore;document.getElementById("jtb-sc").textContent=jScore;
  }else{
    btn.classList.add("wrong");fb.textContent="❌ الإجابة الصحيحة هي: "+correct;fb.className="jfeedback no";
    playWrong();flashEl("r");
    document.querySelectorAll(".jopt").forEach(b=>{if(b.querySelector(".jopt-text").textContent===correct)b.classList.add("correct")});
  }
  const nb=document.getElementById("jnext");nb.className="jnext show";
  if(jCurrent===7)nb.textContent="🏆 شوف نتيجتي!";
}

function jNextQ(){
  playClick();jCurrent++;
  if(jCurrent>=8)showEnd("jobs",jScore,8);else jRender();
}

/* ══════════════════════════════
   NUMBERS ACTIVITY
══════════════════════════════ */
const NROUNDS=[
  {label:"الجولة 1 — الأعداد من 1 إلى 5",min:1,max:5},
  {label:"الجولة 2 — الأعداد من 1 إلى 10",min:1,max:10},
  {label:"الجولة 3 — الأعداد من 1 إلى 15",min:1,max:15},
  {label:"الجولة 4 — الأعداد من 1 إلى 20",min:1,max:20},
];
let nRound=0,nScore=0,nShuffled=[],nSlots=[],nDragSrc=null,nSelected=null;

function startNums(){
  playClick();currentActivity="nums";
  nRound=0;nScore=0;
  document.getElementById("ntb-name").textContent="👤 "+playerName;
  document.getElementById("ntb-cls").textContent="🏫 فصل "+playerClass;
  document.getElementById("ntb-sc").textContent="0";
  hideAll();
  document.getElementById("nums-app").style.display="block";
  nBuildDots();nLoadRound();
}

function nBuildDots(){
  const c=document.getElementById("nrdots");c.innerHTML="";
  NROUNDS.forEach((_,i)=>{const d=document.createElement("div");d.className="rdot"+(i===0?" curr":"");d.id="nrd-"+i;c.appendChild(d);});
}
function nUpdateDots(){NROUNDS.forEach((_,i)=>{const d=document.getElementById("nrd-"+i);if(d)d.className="rdot"+(i<nRound?"done":i===nRound?"curr":"");})}

function nLoadRound(){
  nSelected=null;document.getElementById("nsel-hint").textContent="";
  const r=NROUNDS[nRound];
  document.getElementById("nrl").textContent=r.label;
  document.getElementById("ninstr").textContent="🔀 رتّب الأعداد من "+r.min+" إلى "+r.max+"!";
  nUpdateDots();
  const nums=Array.from({length:r.max-r.min+1},(_,i)=>r.min+i);
  nShuffled=shuffle([...nums]);nSlots=Array(nums.length).fill(null);
  nRenderPool();nRenderSlots();
  document.getElementById("nresult").textContent="";document.getElementById("nresult").className="nresult";
  document.getElementById("ncheck").className="check-btn";document.getElementById("nnext").className="nnext";
}

function nRenderPool(){
  const p=document.getElementById("npool");p.innerHTML="";
  nShuffled.forEach(n=>{if(n!==null)p.appendChild(nMakeTile(n,true,null));});
}
function nRenderSlots(){
  const s=document.getElementById("nslots");s.innerHTML="";
  const r=NROUNDS[nRound];
  nSlots.forEach((val,idx)=>{
    const slot=document.createElement("div");slot.className="slot"+(val!==null?" filled":"");slot.dataset.idx=idx;
    const hint=document.createElement("span");hint.className="slot-num";hint.textContent=r.min+idx;slot.appendChild(hint);
    if(val!==null)slot.appendChild(nMakeTile(val,false,idx));
    slot.addEventListener("dragover",e=>{e.preventDefault();slot.classList.add("drag-over-slot")});
    slot.addEventListener("dragleave",()=>slot.classList.remove("drag-over-slot"));
    slot.addEventListener("drop",e=>{e.preventDefault();slot.classList.remove("drag-over-slot");nHandleDrop("slot",idx)});
    slot.addEventListener("click",()=>nHandleSlotClick(idx));
    s.appendChild(slot);
  });
  nUpdateCheck();
}
function nMakeTile(n,fromPool,slotIdx){
  const t=document.createElement("div");t.className="tile";t.textContent=n;
  t.dataset.num=n;t.dataset.fromPool=fromPool?"1":"0";if(slotIdx!==null)t.dataset.slotIdx=slotIdx;
  t.draggable=true;
  t.addEventListener("dragstart",e=>{nDragSrc={num:n,fromPool,slotIdx};t.classList.add("dragging");e.dataTransfer.effectAllowed="move"});
  t.addEventListener("dragend",()=>t.classList.remove("dragging"));
  t.addEventListener("click",e=>{e.stopPropagation();nHandleTileClick(n,fromPool,slotIdx)});
  return t;
}
function nHandleTileClick(n,fromPool,slotIdx){
  playClick();
  if(nSelected&&nSelected.num===n&&nSelected.fromPool===fromPool&&nSelected.slotIdx===slotIdx){nSelected=null;document.getElementById("nsel-hint").textContent="";nRenderPool();nRenderSlots();return;}
  nSelected={num:n,fromPool,slotIdx};document.getElementById("nsel-hint").textContent="✨ العدد "+n+" محدد — اضغط على الخانة";
  nRenderPool();nRenderSlots();
  document.querySelectorAll(".tile").forEach(t=>{
    if(nSelected&&parseInt(t.dataset.num)===nSelected.num&&(t.dataset.fromPool==="1")===nSelected.fromPool&&(nSelected.slotIdx===null?!t.dataset.slotIdx:parseInt(t.dataset.slotIdx)===nSelected.slotIdx))t.classList.add("selected");
  });
}
function nHandleSlotClick(targetIdx){
  if(!nSelected)return;playPlace();
  const {num,fromPool,slotIdx:srcIdx}=nSelected;
  const existing=nSlots[targetIdx];
  nSlots[targetIdx]=num;
  if(fromPool){nShuffled=nShuffled.filter(x=>x!==num);if(existing!==null)nShuffled.push(existing);}
  else{nSlots[srcIdx]=existing;}
  nSelected=null;document.getElementById("nsel-hint").textContent="";nRenderPool();nRenderSlots();
}
function nHandleDrop(target,targetIdx){
  if(!nDragSrc)return;const {num,fromPool,slotIdx:srcIdx}=nDragSrc;nDragSrc=null;
  if(target==="slot"){const existing=nSlots[targetIdx];nSlots[targetIdx]=num;if(fromPool){nShuffled=nShuffled.filter(x=>x!==num);if(existing!==null)nShuffled.push(existing);}else{nSlots[srcIdx]=existing;}}
  else{if(!fromPool){nSlots[srcIdx]=null;nShuffled.push(num);}}
  playPlace();nRenderPool();nRenderSlots();
}
function nDragOverZone(e,zone){e.preventDefault();if(zone==="pool")document.getElementById("npool").classList.add("drag-over")}
function nDragLeaveZone(e,zone){if(zone==="pool")document.getElementById("npool").classList.remove("drag-over")}
function nDropZone(e,zone){e.preventDefault();document.getElementById("npool").classList.remove("drag-over");if(zone==="pool")nHandleDrop("pool",null)}
function nUpdateCheck(){const all=nSlots.every(v=>v!==null);document.getElementById("ncheck").className="check-btn"+(all?" ready":"")}

function nCheckAnswer(){
  playClick();const r=NROUNDS[nRound];let allOk=true;
  nSlots.forEach((val,idx)=>{
    const exp=r.min+idx;
    const se=document.getElementById("nslots").children[idx];
    const te=se?se.querySelector(".tile"):null;
    if(val===exp){se&&se.classList.add("correct-slot");te&&te.classList.add("correct-tile");}
    else{allOk=false;se&&se.classList.add("wrong-slot");te&&te.classList.add("wrong-tile");}
  });
  const res=document.getElementById("nresult");
  if(allOk){nScore++;res.textContent="🌟 ممتاز! الترتيب صحيح!";res.className="nresult ok";playCorrect();flashEl("g");document.getElementById("ntb-sc").textContent=nScore;}
  else{res.textContent="❌ في أخطاء — الخانات الحمراء في مكان خاطئ!";res.className="nresult no";playWrong();flashEl("r");}
  document.getElementById("ncheck").className="check-btn";
  const nb=document.getElementById("nnext");nb.className="nnext show";
  if(nRound===NROUNDS.length-1)nb.textContent="🏆 شوف نتيجتي!";
  document.querySelectorAll(".tile").forEach(t=>t.style.pointerEvents="none");
}
function nNextRound(){playClick();nRound++;if(nRound>=NROUNDS.length)showEnd("nums",nScore,NROUNDS.length);else nLoadRound()}

/* ══ SHARED END ══ */
let lastActivity="";
function showEnd(act,sc,total){
  hideAll();lastActivity=act;
  document.getElementById("end-screen").style.display="block";
  document.getElementById("end-act").textContent=act==="jobs"?"نشاط: تعلم المهن 👨‍⚕️":"نشاط: رتّب الأعداد 🔢";
  document.getElementById("end-player").textContent="أحسنت يا "+playerName+" 🎉";
  document.getElementById("end-sc").textContent="حصلت على "+sc+" من "+total+" صحيحة";
  const pct=sc/total;
  let stars="⭐";if(pct>=.875)stars="⭐⭐⭐";else if(pct>=.6)stars="⭐⭐";
  document.getElementById("end-stars").textContent=stars;
  playCelebration();if(pct>=.5)confetti();
}
function endReplay(){if(lastActivity==="jobs")startJobs();else startNums()}

/* ══ UTILS ══ */
function shuffle(a){return[...a].sort(()=>Math.random()-.5)}

function confetti(){
  const colors=["#f5c842","#3de8b0","#5bc8ff","#c084fc","#ff6b8a","#ff9f4a"];
  for(let i=0;i<80;i++){setTimeout(()=>{const el=document.createElement("div");el.className="cp";el.style.left=Math.random()*100+"vw";el.style.top="-20px";el.style.background=colors[Math.floor(Math.random()*colors.length)];el.style.animationDuration=(2+Math.random()*2.5)+"s";el.style.animationDelay=Math.random()*.5+"s";const sz=(7+Math.random()*11)+"px";el.style.width=sz;el.style.height=sz;el.style.borderRadius=Math.random()>.5?"50%":"3px";document.body.appendChild(el);setTimeout(()=>el.remove(),5000)},i*28);}
}
</script>
